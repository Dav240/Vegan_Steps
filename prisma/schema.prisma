// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

enum UserType {
  CLIENT
  MODERATOR
}

enum RecipeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTION_TAKEN
}

enum ReportReason {
  NOT_VEGAN
  UNSAFE_ALLERGEN
  COPYRIGHT_INFRINGEMENT
  INAPPROPRIATE_IMAGE
  UNSAFE_INFORMATION
  ILLEGAL_OR_OFFENSIVE_CONTENT
  OTHER
}

enum EmailVerificationPurpose {
  REGISTER
  CHANGE_EMAIL_OLD
  CHANGE_EMAIL_NEW
  PASSWORD_RESET
}

enum Unit {
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  TEASPOON
  TABLESPOON
  CUP
  PIECE
  PINCH
  POUNDS
  OUNCES
  NONE
}

enum Tag {
  PROTEIN_RICH
  GLUTEN_FREE
  GLUTEN
  CONTAINS_NUTS
  CONTAINS_SOY
  SNACK
  PARTY_MEAL
  BREAKFAST
  MEAL_PREP
  SALAD
  SIDE_DISH
  DESSERT
  SAVOURY
  SWEET
  UMAMI
  SPICY
  CREAMY
  CRISPY
  BITTER
  SOUR
  MEXICAN
  SOUTH_AMERICAN
  CARRIBEAN
  ITALIAN
  FRENCH
  MEDITERRANEAN
  INDIAN
  CHINESE
  JAPANESE 
  KOREAN
  SOUTHEAST_ASIAN
  MIDDLE_EASTERN
  PERSIAN
  NORTH_AFRICAN
  EAST_AND_WEST_AFRICAN
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  emailVerified          Boolean        @default(false)
  username               String         @unique
  password               String
  userType               UserType       @default(CLIENT)
  isDeleted              Boolean        @default(false)
  deletedAt              DateTime?
  optionalDataDeletedAt  DateTime?
  termsAcceptedAt        DateTime?
  termsVersion           String?
  privacyNoticeSeenAt    DateTime?
  allergenDisclaimerAcceptedAt DateTime?
  communityGuidelinesVersion   String?
  personalisedRecommendationsEnabled Boolean @default(false)
  analyticsEnabled       Boolean        @default(false)
  productEmailsEnabled   Boolean        @default(false)

  recipes                Recipe[]       @relation("UserRecipes")
  ratings                Rating[]
  savedRecipes           SavedRecipe[]
  reportsMade            Report[]       @relation("ReportsMade")
  emailVerificationCodes EmailVerificationCode[]

  reportsResolved        Report[]       @relation("ReportsResolved")
  approvedRecipes        Recipe[]       @relation("ApprovedRecipes")

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  recipeViews            RecipeView[]

  @@index([isDeleted, deletedAt])
}

model EmailVerificationCode {
  id           String                   @id @default(cuid())
  email        String
  codeHash     String
  purpose      EmailVerificationPurpose
  userId       String?
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingEmail String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime                 @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([userId, purpose])
}

model Recipe {
  id              String            @id @default(cuid())
  name            String
  description     String
  servings        Int
  viewCount       Int               @default(0)
  averageRating   Decimal           @db.Decimal(2, 1)
  isDeleted       Boolean           @default(false)

  prepTimeMinutes Int?
  cookTimeMinutes Int?

  status          RecipeStatus  @default(DRAFT)

  imageUrl        String?
  imageKey        String?

  authorId        String
  author          User              @relation("UserRecipes", fields: [authorId], references: [id], onDelete: Cascade)

  approvedById    String?
  approvedBy      User?             @relation("ApprovedRecipes", fields: [approvedById], references: [id])

  ingredients     Ingredient[]
  stepsPrep       InstructionStep[] @relation("RecipePrepSteps")
  stepsCook       InstructionStep[] @relation("RecipeCookSteps")
  tags            Tag[]
  ratings         Rating[]
  savedBy         SavedRecipe[]
  reports         Report[]

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  views           RecipeView[]

  @@index([status])
  @@index([authorId])
  @@index([name])
}

model Ingredient {
  id       String @id @default(cuid())
  name     String
  quantity Float?
  unit     Unit?

  order    Int

  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model InstructionStep {
  id           String  @id @default(cuid())
  number       Int
  text         String

  prepRecipeId String?
  prepRecipe   Recipe? @relation("RecipePrepSteps", fields: [prepRecipeId], references: [id], onDelete: Cascade)

  cookRecipeId String?
  cookRecipe   Recipe? @relation("RecipeCookSteps", fields: [cookRecipeId], references: [id], onDelete: Cascade)

  @@unique([prepRecipeId, number])
  @@unique([cookRecipeId, number])
  @@index([prepRecipeId])
  @@index([cookRecipeId])
}

model Rating {
  id        String   @id @default(cuid())
  stars     Int

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, recipeId])
  @@index([recipeId])
}

model SavedRecipe {
  userId    String
  recipeId  String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, recipeId])
}

model Report {
  id           String        @id @default(cuid())
  title        String
  reason       ReportReason
  details      String?
  status       ReportStatus  @default(OPEN)
  isDeleted    Boolean       @default(false)

  reporterId   String
  reporter     User          @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  recipeId     String
  recipe       Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  resolvedById String?
  resolvedBy   User?         @relation("ReportsResolved", fields: [resolvedById], references: [id])

  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([recipeId])
  @@index([reporterId])
}

model RecipeView {
  id       String   @id @default(cuid())

  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@index([userId, viewedAt])
  @@index([recipeId, viewedAt])
  @@index([viewedAt])
}
